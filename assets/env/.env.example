# Template for per-environment config. Copy this file to .env.dev,
# .env.staging, or .env.prod in this same folder and fill in real values.
# The filled-in files are gitignored - never commit real keys.
#
# Which file gets loaded at runtime is controlled by --dart-define=ENVIRONMENT=<dev|staging|prod>
# (defaults to "dev" if not passed). See lib/core/config/app_environment.dart.

# Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Sentry project settings -> Client Keys (DSN). Leave blank to disable
# crash reporting for that environment (e.g. local dev, if you'd rather not
# spam your Sentry project with debug-build errors).
SENTRY_DSN=
