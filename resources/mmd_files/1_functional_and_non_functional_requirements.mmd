flowchart LR
    ROOT["CURIO LEARNING PLATFORM"]

    ROOT --> FR["Functional Requirements"]
    ROOT --> NFR["Non-Functional Requirements"]

    FR --> ACCOUNT["Parent Account and Consent"]
    ACCOUNT --> ACCOUNT1["Register, sign in, reset password and sign out"]
    ACCOUNT --> ACCOUNT2["Verify email and maintain parent profile"]
    ACCOUNT --> ACCOUNT3["Record versioned parental consent and privacy acceptance"]
    ACCOUNT --> ACCOUNT4["Export or delete family data"]

    FR --> CHILD["Child Profiles"]
    CHILD --> CHILD1["Create and edit child profiles"]
    CHILD --> CHILD2["Choose avatar, age band and language"]
    CHILD --> CHILD3["Select the active child"]
    CHILD --> CHILD4["Protect parent areas and profile switching with a PIN"]

    FR --> LEARN["Learning Experience"]
    LEARN --> LEARN1["Receive adaptive maths quests"]
    LEARN --> LEARN2["Play the daily Squeeze number challenge"]
    LEARN --> LEARN3["Enter branching story worlds"]
    LEARN --> LEARN4["Complete encounters, dissections and debates"]
    LEARN --> LEARN5["Practise IPM and MAT skills"]
    LEARN --> LEARN6["Pause and resume an activity"]

    FR --> PROGRESS["Progress and Rewards"]
    PROGRESS --> PROGRESS1["Save sessions, answers and explanations viewed"]
    PROGRESS --> PROGRESS2["Track skill mastery and confidence"]
    PROGRESS --> PROGRESS3["Award server-validated XP, streaks and badges"]
    PROGRESS --> PROGRESS4["Evolve the child companion"]
    PROGRESS --> PROGRESS5["Collect discoverable facts"]
    PROGRESS --> PROGRESS6["Recommend the next useful activity"]

    FR --> PARENT["Parent Experience"]
    PARENT --> PARENT1["View progress, effort and mastery trends"]
    PARENT --> PARENT2["See strengths and recurring misconceptions"]
    PARENT --> PARENT3["Configure learning time and activity controls"]
    PARENT --> PARENT4["Receive weekly summaries and reminders"]

    FR --> CONTENT["Content Operations"]
    CONTENT --> CONTENT1["Create and version questions, stories and facts"]
    CONTENT --> CONTENT2["Review, publish, archive and roll back content"]
    CONTENT --> CONTENT3["Target age band, language, skill and difficulty"]
    CONTENT --> CONTENT4["Maintain an administrator audit trail"]

    FR --> PLATFORM["Platform Behaviour"]
    PLATFORM --> PLATFORM1["Cache assigned activities for offline use"]
    PLATFORM --> PLATFORM2["Queue writes and synchronize after reconnecting"]
    PLATFORM --> PLATFORM3["Send optional reminders and weekly reports"]
    PLATFORM --> PLATFORM4["Provide feedback, support and safe empty states"]

    NFR --> PERFORMANCE["Performance"]
    PERFORMANCE --> PERF1["Cold start below three seconds on target devices"]
    PERFORMANCE --> PERF2["Cached interactions below 100 milliseconds"]
    PERFORMANCE --> PERF3["Backend API p95 below 500 milliseconds"]
    PERFORMANCE --> PERF4["Lazy-load secondary worlds and media"]

    NFR --> RELIABILITY["Availability and Reliability"]
    RELIABILITY --> REL1["Target 99.9 percent monthly backend availability"]
    RELIABILITY --> REL2["Never lose a locally completed response"]
    RELIABILITY --> REL3["Use idempotent writes and transactional rewards"]
    RELIABILITY --> REL4["Recover interrupted sessions safely"]

    NFR --> SECURITY["Security"]
    SECURITY --> SEC1["Use Firebase Authentication and secure device token storage"]
    SECURITY --> SEC2["Enforce ownership and roles with Firestore Security Rules"]
    SECURITY --> SEC3["Validate answers, scores and rewards on the server"]
    SECURITY --> SEC4["Rate-limit sensitive and gameplay endpoints"]
    SECURITY --> SEC5["Use custom claims for parent and administrator roles"]
    SECURITY --> SEC6["Use Firebase App Check on supported services"]

    NFR --> PRIVACY["Child Privacy and Safety"]
    PRIVACY --> PRIV1["Collect only data required for learning"]
    PRIVACY --> PRIV2["Require verifiable parental consent"]
    PRIVACY --> PRIV3["Do not use behavioural advertising"]
    PRIVACY --> PRIV4["Define retention, export and deletion workflows"]
    PRIVACY --> PRIV5["Keep analytics privacy-safe and pseudonymous"]

    NFR --> ACCESS["Accessibility and Usability"]
    ACCESS --> ACCESS1["Target WCAG 2.2 AA"]
    ACCESS --> ACCESS2["Support screen readers and keyboard navigation"]
    ACCESS --> ACCESS3["Support scalable text and reduced motion"]
    ACCESS --> ACCESS4["Use age-appropriate language and feedback"]

    NFR --> MAINTAIN["Maintainability and Quality"]
    MAINTAIN --> MAIN1["Use feature-based Flutter modules"]
    MAINTAIN --> MAIN2["Use typed models and repository contracts"]
    MAINTAIN --> MAIN3["Version Firestore rules, indexes, Functions and data migrations"]
    MAINTAIN --> MAIN4["Run automated unit, widget, integration and API tests"]
    MAINTAIN --> MAIN5["Enforce CI analysis, formatting and test checks"]

    NFR --> OBS["Observability"]
    OBS --> OBS1["Capture crashes and performance regressions"]
    OBS --> OBS2["Trace backend jobs and trusted gameplay operations"]
    OBS --> OBS3["Alert on synchronization and publishing failures"]
    OBS --> OBS4["Keep security and administrator audit logs"]
