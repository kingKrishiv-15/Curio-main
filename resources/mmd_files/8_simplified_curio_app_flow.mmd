    T -- Yes --> U["Validate Response on Server"]
    T -- No --> V["Save Response to Offline Queue"]
    V --> W["Reconnect and Synchronize Idempotently"]
    W --> U

    U --> X{"Activity complete?"}
    X -- No --> S
